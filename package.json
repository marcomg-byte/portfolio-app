{
  "name": "@marcomg-byte/portfolio-app",
  "version": "1.0.0",
  "packageManager": "yarn@4.16.0",
  "engines": {
    "node": ">=24 <25"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"yarn theme:watch\" \"next dev\"",
    "build": "yarn theme:run && next build",
    "start": "next start",
    "test": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "text:ui": "vitest --ui",
    "test:watch": "vitest watch",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "theme:check": "tsc -p tsconfig.tailwind.json",
    "theme:run": "tsx parse-theme.mts",
    "theme:watch": "nodemon --watch tokens.json --ext json --exec \"yarn theme:run\""
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/react-fontawesome": "^3.3.0",
    "classnames": "^2.5.1",
    "colord": "^2.9.3",
    "embla-carousel": "^8.6.0",
    "embla-carousel-fade": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "next": "16.2.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "4.1.8",
    "concurrently": "^10.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "jsdom": "^29.1.1",
    "nodemon": "^3.1.14",
    "postcss": "^8.5.9",
    "postcss-js": "^5.1.0",
    "prettier": "^3.8.2",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.8"
  }
}
