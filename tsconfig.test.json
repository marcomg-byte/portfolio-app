{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    },
    "jsx": "react-jsx",
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "types": ["node"]
  },
  "include": [
    "vitest.config.mts",
    "test/**/*.spec.ts",
    "test/**/*.spec.tsx",
    "test/**/*.test.ts",
    "test/**/*.test.tsx"
  ],
  "exclude": [
    "node_modules",
    "app",
    ".next",
    ".yarn",
    "components",
    "public"
  ]
}
